{
  "workspace": [
    "./pascal-to-js",
    "./integration",
    "./boot-tex"
  ],
  "unstable": ["sloppy-imports"],
  "tasks": {
    "test": "deno test -A pascal-to-js/tests/",
    "test:unit": "deno test -A pascal-to-js/tests/unit/",
    "test:integration": "deno test -A pascal-to-js/tests/integration/",
    "test:benchmark": "deno test -A pascal-to-js/tests/benchmark/",
    "check": "deno check pascal-to-js/src/index.ts"
  },
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true
  }
}
