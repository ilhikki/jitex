{
  "workspace": [
    "./pascal-to-js",
    "./integration",
    "./boot-tex"
  ],
  "unstable": ["sloppy-imports"],
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "boot-tangle": "deno run -A ./integration/src/cli.ts run ./boot-tex/src/tangle/boot-tangle.ts",
    "boot-tex": "deno run -A ./integration/src/cli.ts run ./boot-tex/src/tex/boot-tex.ts"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true
  }
}
