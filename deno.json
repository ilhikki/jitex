{
  "workspace": [
    "./pascal-to-js",
    "./integration",
    "./boot-tex"
  ],
  "unstable": ["sloppy-imports"],
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true
  }
}
