{
  "workspace": [
    "./src/runtime",
    "./src/pascal-to-js",
    "./src/integration",
    "./src/tex-runtime"
  ],
  "exclude": ["reports", "resources", "dist", "src/web"],
  "compilerOptions": {
    "strict": true
  },
  "imports": {
    "@deno/emit": "jsr:@deno/emit@^0.46.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "tasks": {
    "build:jitex": "deno run --allow-read --allow-write --allow-env --allow-net=jsr.io ./src/integration/cli.ts run ./src/boot-tex/build-jitex.ts"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "plugins": [
      "jsr:@aireone/deno-lint-curly"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true
  }
}
